          "values": [
            {
              "fieldLabel": "Policy number",
              "requiredField": true
            },
            {
              "fieldLabel": "Product",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "motor"
                  },
                  {
                    "option": "home"
                  },
                  {
                    "option": "travel"
                  }
                ]
              }
            },
            {
              "fieldLabel": "What happened?",
              "fieldType": "textarea",
              "requiredField": true
            },
            {
              "fieldLabel": "Incident date",
              "fieldType": "date"
            },
            {
              "fieldLabel": "Claimed amount (PLN)",
              "fieldType": "number"
            },
            {
              "fieldLabel": "Email",
              "fieldType": "email",
              "requiredField": true
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {
          "path": "claims-hub/report"
        }
      },
      "webhookId": "25224a0c-d708-4e01-b223-b1e09b504424"
    },
