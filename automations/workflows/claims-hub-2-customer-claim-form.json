      ],
      "parameters": {
        "formTitle": "Report a claim",
        "formDescription": "Tell us what happened. We reply within one business day.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Policy number",
              "requiredField": true
            },
            {
              "fieldLabel": "Product",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "motor"
                  },
                  {
                    "option": "home"
                  },
                  {
                    "option": "travel"
                  }
                ]
              }
            },
            {
              "fieldLabel": "What happened?",
              "fieldType": "textarea",
              "requiredField": true
            },
            {
              "fieldLabel": "Incident date",
              "fieldType": "date"
            },
            {
              "fieldLabel": "Claimed amount (PLN)",
              "fieldType": "number"
            },
            {
              "fieldLabel": "Email",
              "fieldType": "email",
              "requiredField": true
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {
          "path": "claims-hub/report"
        }
      },
      "webhookId": "dfdbcad6-6978-4fec-8eaa-939125f66115"
    },
