        "formFields": {
          "values": [
            {
              "fieldLabel": "Policy number",
              "requiredField": true
            },
            {
              "fieldLabel": "Product",
              "fieldType": "dropdown",
              "requiredField": true,
              "fieldOptions": {
                "values": [
                  {
                    "option": "motor"
                  },
                  {
                    "option": "home"
                  },
                  {
                    "option": "travel"
                  }
                ]
              }
            },
            {
              "fieldLabel": "What happened?",
              "fieldType": "textarea",
              "requiredField": true
            },
            {
              "fieldLabel": "Incident date",
              "fieldType": "date"
            },
            {
              "fieldLabel": "Claimed amount (PLN)",
              "fieldType": "number"
            },
            {
              "fieldLabel": "Email",
              "fieldType": "email",
              "requiredField": true
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {
          "path": "claims-hub/report"
        }
      },
      "webhookId": "da2b9e54-fc1c-414e-8793-bf445ec0709f"
    },
