{
  "name": "Claims Hub · 6 · Daily KPI digest",
  "nodes": [
    {
      "id": "b98b5a82-5862-4e40-8e74-19467dab01c0",
      "name": "Section · 07:00 every day",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "content": "## 07:00 every day\nClaims received in the last 24 hours.",
        "width": 680,
        "height": 620,
        "color": 7
      }
    },
    {
      "id": "5882b165-20cf-40dd-b99b-4d634942ed8d",
      "name": "Section · Aggregate",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        700,
        0
      ],
      "parameters": {
        "content": "## Aggregate\nPer-lane counts and totals in parallel.",
        "width": 920,
        "height": 620,
        "color": 6
      }
    },
    {
      "id": "23aecac1-36ed-4aa4-96b4-b1d0580e7b75",
      "name": "Section · Publish",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1640,
        0
      ],
      "parameters": {
        "content": "## Publish\nStore the KPI row, send the digest, count time saved.",
        "width": 1120,
        "height": 620,
        "color": 4
      }
    },
    {
      "id": "4ef83266-799e-40f8-81cb-df0406512510",
      "name": "Every day 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        120,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "212b43b2-8be7-48c5-9e2f-d063b14ddf17",
      "name": "All claims",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        340,
        300
      ],
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "df572166-809d-4d78-a523-6ab7e326142f",
          "mode": "id"
        },
        "returnAll": true,
        "options": {}
      }
    },
    {
      "id": "f20acd56-3854-4cd3-9520-a493f8cc9494",
      "name": "Last 24 hours",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.4,
      "position": [
        560,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "7515363e-af10-4a69-a958-27473efd07e3",
              "leftValue": "={{ $json.received_at }}",
              "operator": {
                "type": "dateTime",
                "operation": "after"
              },
              "rightValue": "={{ $now.minus({ days: 1 }).toISO() }}"
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "85dcc015-10c3-464a-a0bd-0b97c16e3691",
      "name": "Per lane",
      "type": "n8n-nodes-base.summarize",
      "typeVersion": 1.1,
      "position": [
        780,
        180
      ],
      "parameters": {
        "fieldsToSummarize": {
          "values": [
            {
              "aggregation": "count",
              "field": "claim_id"
            }
          ]
        },
        "fieldsToSplitBy": "next_step",
        "options": {}
      }
    },
    {
      "id": "aa95e0f9-1cc5-4b40-8232-46f581f8888b",
      "name": "Totals",
      "type": "n8n-nodes-base.summarize",
      "typeVersion": 1.1,
      "position": [
        780,
        420
      ],
      "parameters": {
        "fieldsToSummarize": {
          "values": [
            {
              "aggregation": "count",
              "field": "claim_id"
            },
            {
              "aggregation": "sum",
              "field": "amount"
            },
            {
              "aggregation": "sum",
              "field": "payout"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a96ccc89-487e-4ea0-b978-acf0678ee84f",
      "name": "Wait for both",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "mode": "append",
        "numberInputs": 2
      }
    },
    {
      "id": "76afbe9d-9b79-4006-8def-c41f2ed0c3cc",
      "name": "One item",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        1220,
        300
      ],
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "rows",
        "options": {}
      }
    },
    {
      "id": "ae7e3801-d22c-46a7-91f1-5f813c236cd7",
      "name": "Build report",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "62bba9ad-e119-4e85-82ff-0822d9907a67",
              "name": "claims",
              "value": "={{ $('Totals').first().json.count_claim_id }}",
              "type": "number"
            },
            {
              "id": "90ba7b3a-6a4d-4554-9e16-ca6f39bcd173",
              "name": "fast_track",
              "value": "={{ ($('Per lane').all().find(i => i.json.next_step === 'fast_track') || { json: { count_claim_id: 0 } }).json.count_claim_id }}",
              "type": "number"
            },
            {
              "id": "04f029ce-7847-4a4e-98ce-a7d2cfb2a47e",
              "name": "adjuster",
              "value": "={{ ($('Per lane').all().find(i => i.json.next_step === 'assign_adjuster') || { json: { count_claim_id: 0 } }).json.count_claim_id }}",
              "type": "number"
            },
            {
              "id": "5427ac7f-f1c7-464f-8af9-509f9d357554",
              "name": "info_requested",
              "value": "={{ ($('Per lane').all().find(i => i.json.next_step === 'request_information') || { json: { count_claim_id: 0 } }).json.count_claim_id }}",
              "type": "number"
            },
            {
              "id": "0dc89d99-6650-4e8e-9782-6bf3bbe7bf12",
              "name": "exclusion_review",
              "value": "={{ ($('Per lane').all().find(i => i.json.next_step === 'review_possible_exclusion') || { json: { count_claim_id: 0 } }).json.count_claim_id }}",
              "type": "number"
            },
            {
              "id": "3301c569-0dcc-417f-8bed-b6afd2a3b1d1",
              "name": "total_claimed",
              "value": "={{ $('Totals').first().json.sum_amount }}",
              "type": "number"
            },
            {
              "id": "334e5ddc-6ed0-4161-bf2b-d40f28a7f504",
              "name": "total_payout",
              "value": "={{ $('Totals').first().json.sum_payout }}",
              "type": "number"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "398bdc93-1f17-45b2-bad6-8c81a3d40b10",
      "name": "Store KPI row",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1700,
        300
      ],
      "parameters": {
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "value": "b24e2eb8-4952-4dbb-9a45-5ac6be33c8c9",
          "mode": "id"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "report_date": "={{ $today.toISO() }}",
            "claims": "={{ $json.claims }}",
            "fast_track": "={{ $json.fast_track }}",
            "adjuster": "={{ $json.adjuster }}",
            "info_requested": "={{ $json.info_requested }}",
            "exclusion_review": "={{ $json.exclusion_review }}",
            "total_claimed": "={{ $json.total_claimed }}",
            "total_payout": "={{ $json.total_payout }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      }
    },
    {
      "id": "561cbf4a-3e51-4979-8d35-69b87d04edcf",
      "name": "Send digest",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1920,
        300
      ],
      "parameters": {
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "value": "f55276ac-a4f5-4fe2-babe-e8b4ef8b740b",
          "mode": "id"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "channel": "email",
            "recipient": "management@claims.example",
            "subject": "=Claims KPI {{ $today.toFormat('yyyy-MM-dd') }}",
            "body": "={{ $('Build report').item.json.claims }} claims | fast track {{ $('Build report').item.json.fast_track }} | adjuster {{ $('Build report').item.json.adjuster }} | info {{ $('Build report').item.json.info_requested }} | review {{ $('Build report').item.json.exclusion_review }} | payout {{ $('Build report').item.json.total_payout }} PLN",
            "created_at": "={{ $now.toISO() }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      }
    },
    {
      "id": "3198d1db-7dbc-4f31-ba18-828a9ca0128c",
      "name": "Count time saved",
      "type": "n8n-nodes-base.timeSaved",
      "typeVersion": 1,
      "position": [
        2140,
        300
      ],
      "parameters": {
        "mode": "once",
        "minutesSaved": 30
      }
    }
  ],
