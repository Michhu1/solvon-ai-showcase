{
  "name": "Claims Hub · 6 · Daily KPI digest",
  "nodes": [
    {
      "id": "6ef81d95-d7f7-42e2-931b-4f6b2cd4465f",
      "name": "Section · 07:00 every day",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "content": "## 07:00 every day\nClaims received in the last 24 hours.",
        "width": 680,
        "height": 620,
        "color": 7
      }
    },
    {
      "id": "4d6a3ba1-1348-420f-b0b4-220e3260f771",
      "name": "Section · Aggregate",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        700,
        0
      ],
      "parameters": {
        "content": "## Aggregate\nPer-lane counts and totals in parallel.",
        "width": 920,
        "height": 620,
        "color": 6
      }
    },
    {
      "id": "e941b5c0-05c9-43ab-84de-bd3aae81cc12",
      "name": "Section · Publish",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1640,
        0
      ],
      "parameters": {
        "content": "## Publish\nStore the KPI row, send the digest, count time saved.",
        "width": 1120,
        "height": 620,
        "color": 4
      }
    },
    {
      "id": "2e06c860-f9d6-4095-9858-664b359b0939",
      "name": "Every day 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        120,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "b4722b51-5fe6-4bf9-a0f1-78a5562aee5c",
      "name": "All claims",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        340,
        300
      ],
      "parameters": {
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "value": "df572166-809d-4d78-a523-6ab7e326142f",
          "mode": "id"
        },
        "returnAll": true,
        "options": {}
      }
    },
    {
      "id": "9939f0db-827c-4421-947a-40d6ab96d85d",
      "name": "Last 24 hours",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.4,
      "position": [
        560,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "f02ab20d-a0a0-4a34-ae94-ac3e8a166787",
              "leftValue": "={{ $json.received_at }}",
              "operator": {
                "type": "dateTime",
                "operation": "after"
              },
              "rightValue": "={{ $now.minus({ days: 1 }).toISO() }}"
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "e76a89e0-dfe1-40d2-8481-32354f535f02",
      "name": "Per lane",
      "type": "n8n-nodes-base.summarize",
      "typeVersion": 1.1,
      "position": [
        780,
        180
      ],
      "parameters": {
        "fieldsToSummarize": {
          "values": [
            {
              "aggregation": "count",
              "field": "claim_id"
            }
          ]
        },
        "fieldsToSplitBy": "next_step",
        "options": {}
      }
    },
    {
      "id": "baba7838-3f7c-4d28-9615-0389f7475579",
      "name": "Totals",
      "type": "n8n-nodes-base.summarize",
      "typeVersion": 1.1,
      "position": [
        780,
        420
      ],
      "parameters": {
        "fieldsToSummarize": {
          "values": [
            {
              "aggregation": "count",
              "field": "claim_id"
            },
            {
              "aggregation": "sum",
              "field": "amount"
            },
            {
              "aggregation": "sum",
              "field": "payout"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "64c41b37-2c45-4891-ac2b-a231cad21df0",
      "name": "Wait for both",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "mode": "append",
        "numberInputs": 2
      }
    },
    {
      "id": "de7385b4-7a7e-47da-9c0f-3e4b712aee96",
      "name": "One item",
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        1220,
        300
      ],
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "rows",
        "options": {}
      }
    },
    {
      "id": "d9ab965f-f34f-4730-8c22-5fbd0077a56b",
      "name": "Build report",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1440,
        300
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "c4cf5e18-870a-4818-9335-8d4c03c308cd",
              "name": "claims",
              "value": "={{ $('Totals').first().json.count_claim_id }}",
              "type": "number"
            },
            {
              "id": "3037a096-c3d7-4e1d-8e78-c5ef69c0f0a0",
              "name": "fast_track",
              "value": "={{ ($('Per lane').all().find(i => i.json.next_step === 'fast_track') || { json: { count_claim_id: 0 } }).json.count_claim_id }}",
              "type": "number"
            },
            {
              "id": "9d4c6630-0d45-4186-ad49-0d974d305cb1",
              "name": "adjuster",
              "value": "={{ ($('Per lane').all().find(i => i.json.next_step === 'assign_adjuster') || { json: { count_claim_id: 0 } }).json.count_claim_id }}",
              "type": "number"
            },
            {
              "id": "94b2b49e-f586-47de-80a6-e04e8e6ab9c6",
              "name": "info_requested",
              "value": "={{ ($('Per lane').all().find(i => i.json.next_step === 'request_information') || { json: { count_claim_id: 0 } }).json.count_claim_id }}",
              "type": "number"
            },
            {
              "id": "a047b860-cd5a-4e5f-9560-19c630263cac",
              "name": "exclusion_review",
              "value": "={{ ($('Per lane').all().find(i => i.json.next_step === 'review_possible_exclusion') || { json: { count_claim_id: 0 } }).json.count_claim_id }}",
              "type": "number"
            },
            {
              "id": "2b23bf66-db02-48fe-9adc-6987c346d4f0",
              "name": "total_claimed",
              "value": "={{ $('Totals').first().json.sum_amount }}",
              "type": "number"
            },
            {
              "id": "a4c333e8-668a-48e8-ad36-f10a1c168416",
              "name": "total_payout",
              "value": "={{ $('Totals').first().json.sum_payout }}",
              "type": "number"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "a13099f8-6122-49aa-b8a9-dbed3eaaf828",
      "name": "Store KPI row",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1700,
        300
      ],
      "parameters": {
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "value": "b24e2eb8-4952-4dbb-9a45-5ac6be33c8c9",
          "mode": "id"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "report_date": "={{ $today.toISO() }}",
            "claims": "={{ $json.claims }}",
            "fast_track": "={{ $json.fast_track }}",
            "adjuster": "={{ $json.adjuster }}",
            "info_requested": "={{ $json.info_requested }}",
            "exclusion_review": "={{ $json.exclusion_review }}",
            "total_claimed": "={{ $json.total_claimed }}",
            "total_payout": "={{ $json.total_payout }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      }
    },
    {
      "id": "54c591a0-c013-428c-b6ec-a5f7d2b87fef",
      "name": "Send digest",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1920,
        300
      ],
      "parameters": {
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "value": "f55276ac-a4f5-4fe2-babe-e8b4ef8b740b",
          "mode": "id"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "channel": "email",
            "recipient": "management@claims.example",
            "subject": "=Claims KPI {{ $today.toFormat('yyyy-MM-dd') }}",
            "body": "={{ $('Build report').item.json.claims }} claims | fast track {{ $('Build report').item.json.fast_track }} | adjuster {{ $('Build report').item.json.adjuster }} | info {{ $('Build report').item.json.info_requested }} | review {{ $('Build report').item.json.exclusion_review }} | payout {{ $('Build report').item.json.total_payout }} PLN",
            "created_at": "={{ $now.toISO() }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      }
    },
    {
      "id": "d98c9c12-64cf-4436-9f42-eb7f6c1a603b",
      "name": "Count time saved",
      "type": "n8n-nodes-base.timeSaved",
      "typeVersion": 1,
      "position": [
        2140,
        300
      ],
      "parameters": {
        "mode": "once",
        "minutesSaved": 30
      }
    }
  ],
