      "position": [
        640,
        240
      ],
      "parameters": {
        "sortFieldsUi": {
          "sortField": [
            {
              "fieldName": "open_tasks",
              "order": "ascending"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a311ce28-1ac4-45cf-a822-b3131b75c4e4",
      "name": "Pick one",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        860,
        240
      ],
