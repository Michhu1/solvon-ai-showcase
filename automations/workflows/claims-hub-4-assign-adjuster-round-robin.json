        260
      ],
      "parameters": {
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "value": "fa8b2b53-4145-4cbb-aa33-0bd0abe9b66c",
          "mode": "id"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "name",
              "condition": "eq",
              "keyValue": "={{ $('Pick one').item.json.name }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "open_tasks": "={{ $('Pick one').item.json.open_tasks + 1 }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      }
    },
