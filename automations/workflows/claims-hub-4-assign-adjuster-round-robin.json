            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "118807ea-e722-417d-8d44-a6944529f3ec",
      "name": "Book workload",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
