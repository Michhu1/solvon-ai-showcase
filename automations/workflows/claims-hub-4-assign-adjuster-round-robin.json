        "dataTableId": {
          "__rl": true,
          "value": "2da00648-39c5-4674-ac1e-f5698ee7d7cc",
          "mode": "id"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "name",
              "condition": "eq",
              "keyValue": "={{ $json.name }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "open_tasks": "={{ $json.open_tasks + 1 }}"
