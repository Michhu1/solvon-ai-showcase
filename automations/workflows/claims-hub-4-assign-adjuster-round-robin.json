        640,
        240
      ],
      "parameters": {
        "sortFieldsUi": {
          "sortField": [
            {
              "fieldName": "open_tasks",
              "order": "ascending"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "36dc67fa-edac-48a4-8e22-c1df40686aae",
      "name": "Pick one",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
