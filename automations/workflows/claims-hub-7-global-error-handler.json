{
  "name": "Claims Hub · 7 · Global error handler",
  "nodes": [
    {
      "id": "7c6448fa-240c-4da6-aefa-c94b7c84b660",
      "name": "Section · Incident capture",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        40,
        120
      ],
      "parameters": {
        "content": "## Incident capture\nEvery Claims Hub workflow points here as its **error workflow**.\nFailures are logged and on-call is alerted.",
        "width": 960,
        "height": 420,
        "color": 3
      }
    },
    {
      "id": "2935c225-a4a6-4260-b45d-634ce7c3c64e",
      "name": "On workflow error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        100,
        300
      ],
      "parameters": {}
    },
    {
      "id": "ad68c92c-6752-49b9-81f5-b329b7259079",
      "name": "Describe incident",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        320,
        300
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "e41625c5-184b-4c0d-b991-14f3565301ef",
              "name": "workflow",
              "value": "={{ $json.workflow.name }}",
              "type": "string"
            },
            {
              "id": "94348b8a-a162-46f6-a0c9-8b8ec6e52fa5",
              "name": "node",
              "value": "={{ $json.execution.lastNodeExecuted }}",
              "type": "string"
            },
            {
              "id": "2a364720-9569-4af1-a6c0-f9b25f9dbdec",
              "name": "message",
              "value": "={{ $json.execution.error.message }}",
              "type": "string"
            },
            {
              "id": "f994b039-53ce-45a8-b343-2f66b5b8a8db",
              "name": "execution_id",
              "value": "={{ $json.execution.id }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "91b1dad7-f94e-4bd7-affa-359b13b0f73a",
      "name": "Log incident",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        540,
        300
      ],
      "parameters": {
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "value": "082ca67c-28df-40e5-a25b-95dabf3b0680",
          "mode": "id"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "workflow": "={{ $json.workflow }}",
            "node": "={{ $json.node }}",
            "message": "={{ $json.message }}",
            "execution_id": "={{ $json.execution_id }}",
            "at": "={{ $now.toISO() }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      }
    },
    {
      "id": "e867aa69-c9af-49f5-948c-6969cf19c28c",
      "name": "Alert on-call",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        760,
        300
      ],
      "parameters": {
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "value": "f55276ac-a4f5-4fe2-babe-e8b4ef8b740b",
          "mode": "id"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "channel": "pager",
            "recipient": "on-call@claims.example",
            "subject": "=Incident in {{ $('Describe incident').item.json.workflow }}",
            "body": "={{ $('Describe incident').item.json.node }}: {{ $('Describe incident').item.json.message }}",
            "created_at": "={{ $now.toISO() }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "On workflow error": {
      "main": [
        [
          {
            "node": "Describe incident",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Describe incident": {
      "main": [
        [
          {
            "node": "Log incident",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log incident": {
      "main": [
        [
          {
            "node": "Alert on-call",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "Europe/Warsaw",
    "executionOrder": "v1"
  }
}
