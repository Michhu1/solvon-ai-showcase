{
  "name": "Claims Hub · 7 · Global error handler",
  "nodes": [
    {
      "id": "9a795134-1f8e-4664-8f32-e1483a2e6c98",
      "name": "Section · Incident capture",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        40,
        120
      ],
      "parameters": {
        "content": "## Incident capture\nEvery Claims Hub workflow points here as its **error workflow**.\nFailures are logged and on-call is alerted.",
        "width": 960,
        "height": 420,
        "color": 3
      }
    },
    {
      "id": "161d9283-c1f3-44ad-82d6-17f61bb837f1",
      "name": "On workflow error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        100,
        300
      ],
      "parameters": {}
    },
    {
      "id": "9220777a-6ce5-44b9-b16d-ff6a85ce28b2",
      "name": "Describe incident",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        320,
        300
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "75bc17f9-5ba0-4513-8f71-20b20848e8ed",
              "name": "workflow",
              "value": "={{ $json.workflow.name }}",
              "type": "string"
            },
            {
              "id": "aa9c635e-ac1b-40af-85dd-6db88cd1ce52",
              "name": "node",
              "value": "={{ $json.execution.lastNodeExecuted }}",
              "type": "string"
            },
            {
              "id": "ed341f1c-1ac9-4506-84b5-7636201ab866",
              "name": "message",
              "value": "={{ $json.execution.error.message }}",
              "type": "string"
            },
            {
              "id": "6249fea9-ab0e-4aa4-9b2c-b6dffee98963",
              "name": "execution_id",
              "value": "={{ $json.execution.id }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "3cfa3ddb-ed8b-4bb6-bc00-dcaf6de95749",
      "name": "Log incident",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        540,
        300
      ],
      "parameters": {
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "value": "082ca67c-28df-40e5-a25b-95dabf3b0680",
          "mode": "id"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "workflow": "={{ $json.workflow }}",
            "node": "={{ $json.node }}",
            "message": "={{ $json.message }}",
            "execution_id": "={{ $json.execution_id }}",
            "at": "={{ $now.toISO() }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      }
    },
    {
      "id": "7af5579c-f548-4ca0-9964-8903c17f2573",
      "name": "Alert on-call",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        760,
        300
      ],
      "parameters": {
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "value": "f55276ac-a4f5-4fe2-babe-e8b4ef8b740b",
          "mode": "id"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "channel": "pager",
            "recipient": "on-call@claims.example",
            "subject": "=Incident in {{ $('Describe incident').item.json.workflow }}",
            "body": "={{ $('Describe incident').item.json.node }}: {{ $('Describe incident').item.json.message }}",
            "created_at": "={{ $now.toISO() }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "On workflow error": {
      "main": [
        [
          {
            "node": "Describe incident",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Describe incident": {
      "main": [
        [
          {
            "node": "Log incident",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log incident": {
      "main": [
        [
          {
            "node": "Alert on-call",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "Europe/Warsaw",
    "executionOrder": "v1"
  }
}
