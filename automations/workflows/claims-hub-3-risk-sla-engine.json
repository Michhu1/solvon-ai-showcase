    {
      "id": "afed2994-6056-4ad3-add7-ca89aa18b881",
      "name": "Risk factors",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        420,
        300
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "abc0c2d7-0508-41fc-866f-4af33ef5b082",
              "name": "amount_points",
              "value": "={{ $json.amount > 20000 ? 40 : ($json.amount > 5000 ? 20 : 5) }}",
              "type": "number"
            },
            {
              "id": "b941ac71-08ba-447f-af30-1d476bddf160",
              "name": "cause_points",
              "value": "={{ /theft|stolen|fire|burglar|break-in/i.test($json.description) ? 25 : 0 }}",
              "type": "number"
            },
            {
              "id": "7b156c30-7127-4209-9b70-a5943a55c357",
              "name": "late_points",
              "value": "={{ $json.incident_date && DateTime.fromISO($json.received_at).diff(DateTime.fromISO($json.incident_date), 'days').days > 14 ? 15 : 0 }}",
              "type": "number"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "f507c978-6b59-45e6-b85f-227b9f19c12f",
      "name": "Risk score",
      "type": "n8n-nodes-base.set",
