    {
      "id": "a90cbaf3-a69e-42ea-af0c-2ed5f980595c",
      "name": "Risk factors",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        420,
        300
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "d0dabe0d-1188-44ab-9d9c-fa352198b0f4",
              "name": "amount_points",
              "value": "={{ $json.amount > 20000 ? 40 : ($json.amount > 5000 ? 20 : 5) }}",
              "type": "number"
            },
            {
              "id": "6b2c130f-ef8b-48ab-b3e9-0d6c7090ebe6",
              "name": "cause_points",
              "value": "={{ /theft|stolen|fire|burglar|break-in/i.test($json.description) ? 25 : 0 }}",
              "type": "number"
            },
            {
              "id": "d0b865a4-4619-4d50-a96a-892db73972fd",
              "name": "late_points",
              "value": "={{ $json.incident_date && DateTime.fromISO($json.received_at).diff(DateTime.fromISO($json.incident_date), 'days').days > 14 ? 15 : 0 }}",
              "type": "number"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "565ea290-f7ba-4c99-a426-4823914ca73a",
      "name": "Risk score",
      "type": "n8n-nodes-base.set",
