    {
      "id": "a91bdebe-9ce6-4533-b151-39285dc2bdd0",
      "name": "Risk factors",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        420,
        300
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "b08f77ea-517f-4d11-a9c3-1546d898da27",
              "name": "amount_points",
              "value": "={{ $json.amount > 20000 ? 40 : ($json.amount > 5000 ? 20 : 5) }}",
              "type": "number"
            },
            {
              "id": "afde1d8d-44f1-4b66-b735-db7742217e7f",
              "name": "cause_points",
              "value": "={{ /theft|stolen|fire|burglar|break-in/i.test($json.description) ? 25 : 0 }}",
              "type": "number"
            },
            {
              "id": "891222fa-b223-401c-94ad-825ab3e86ab9",
              "name": "late_points",
              "value": "={{ $json.incident_date && DateTime.fromISO($json.received_at).diff(DateTime.fromISO($json.incident_date), 'days').days > 14 ? 15 : 0 }}",
              "type": "number"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
      "id": "8cb93a20-649a-4118-b185-d3f57b348337",
      "name": "Risk score",
      "type": "n8n-nodes-base.set",
