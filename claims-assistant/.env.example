# Defaults run fully offline. Fill in the Azure values to use real services.

# offline | azure_openai
LLM_BACKEND=offline
# bm25 | azure_search
RETRIEVER=bm25
MAX_STEPS=6
TOP_K=3

# Azure OpenAI (Azure AI Foundry). Leave the key empty to use Microsoft Entra ID instead.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Azure AI Search. Leave the key empty to use Microsoft Entra ID instead.
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=policy-clauses
AZURE_SEARCH_SEMANTIC_CONFIG=

# Log eval runs to the MLflow server from docker compose instead of the local mlruns/ folder.
# MLFLOW_TRACKING_URI=http://localhost:5000
